  font-weight: bold;
  font-family: NumBold;
}
.ht-lab {
  color: #9d9d95;
  font-size: 16px;
  line-height: 22px;
  margin-top: 4px;
}
.ht-swap {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #161818;
  border-radius: 16px;
  padding: 9px 16px;
  margin-top: 12px;
}
.ht-swap-icon {
  width: 18px;
  height: 18px;
  margin-right: 8px;
}
.ht-swap-arrow {
  width: 14px;
  height: 14px;
  margin-left: 5px;
  margin-right: 5px;
}
