  width: 100%;
  flex-direction: row;
  align-items: center;
  height: 34px;
  justify-content: center;
  margin-bottom: 10px;
}
.resume-half-arrow {
  width: 13px;
  height: 13px;
  margin-right: 5px;
}
.resume-half-text {
  color: #e5e5dc;
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
}
.ht-top {
  flex-direction: column;
  align-items: center;
}
.ht-chip {
  border: 1px;
  border-color: rgba(229, 229, 220, 0.12);
  border-radius: 999px;
  padding: 6px 14px;
}
.ht-chip-text {
  color: #9d9d95;
  font-size: 17px;
  line-height: 24px;
}
.ht-duration {
  color: #9d9d95;
  font-size: 19px;
  line-height: 26px;
  font-weight: bold;
  margin-top: 6px;
}
.ht-center {
  flex-direction: column;
  align-items: center;
  margin-top: 10px;
}
.ht-title {
  color: #e5e5dc;
  font-size: 40px;
  line-height: 50px;
  font-weight: bold;
  text-align: center;
}
.ht-stats {
  flex-direction: row;
  align-items: center;
  width: 336px;
  border-top: 1px;
  border-top-color: rgba(229, 229, 220, 0.12);
  padding-top: 10px;
  margin-top: 12px;
}
.ht-col {
  flex: 1;
  flex-direction: column;
  align-items: center;
}
.ht-vline {
  width: 1px;
  align-self: stretch;
  background-color: rgba(229, 229, 220, 0.12);
  margin-left: 12px;
  margin-right: 12px;
}
.ht-num {
  color: #e5e5dc;
  font-size: 38px;
