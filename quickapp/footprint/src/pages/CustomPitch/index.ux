<template>
  <div class="screen screen-round">
    <div class="fit fit-round">
      <div class="status-space"></div>
      <text class="page-title">自定义球场</text>

      <div class="form-card">
        <text class="field-label">球场名称</text>
        <input class="name-input" type="text" value="{{name}}" placeholder="自定义球场" onchange="onNameChange">
      </div>

      <div class="dimension-row">
        <div class="dim-card">
          <text class="field-label">长度 (m)</text>
          <text class="dim-value">{{length}}</text>
          <div class="stepper">
            <div class="step-btn" onclick="onLengthMinus">
              <text class="step-text">-</text>
            </div>
            <div class="step-btn step-btn-plus" onclick="onLengthPlus">
              <text class="step-text">+</text>
            </div>
          </div>
        </div>
        <div class="dim-card">
          <text class="field-label">宽度 (m)</text>
          <text class="dim-value">{{width}}</text>
          <div class="stepper">
            <div class="step-btn" onclick="onWidthMinus">
              <text class="step-text">-</text>
            </div>
            <div class="step-btn step-btn-plus" onclick="onWidthPlus">
              <text class="step-text">+</text>
            </div>
          </div>
        </div>
      </div>

      <div class="spacer"></div>
      <div class="save-cta {{canSave ? '' : 'save-cta-disabled'}}" onclick="onSave">
        <text class="save-cta-text">保存</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { attachStorage, createCustomPitch, storageAdapter } from '../../common/app_state.js'
import storage from '@system.storage'

const MIN_LENGTH = 10
const MAX_LENGTH = 200
const MIN_WIDTH = 5
const MAX_WIDTH = 100
const STEP = 1

export default {
  private: {
    name: '自定义球场',
    length: 40,
    width: 20,
    canSave: true
  },
  onShow() {
    attachStorage(storageAdapter(storage))
  },
  onNameChange(evt) {
    if (!evt) return
    const raw = (evt.value || evt.text || '').trim()
    this.canSave = raw.length > 0
    this.name = raw || '自定义球场'
  },
  onLengthMinus() {
    if (this.length > MIN_LENGTH) this.length -= STEP
  },
  onLengthPlus() {
    if (this.length < MAX_LENGTH) this.length += STEP
  },
  onWidthMinus() {
    if (this.width > MIN_WIDTH) this.width -= STEP
  },
  onWidthPlus() {
    if (this.width < MAX_WIDTH) this.width += STEP
  },
  onSave() {
    if (!this.canSave) return
    createCustomPitch(this.name, this.length, this.width).then(() => {
      router.back()
    }).catch(() => {})
  }
}
</script>

