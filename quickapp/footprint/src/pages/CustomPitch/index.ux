  font-weight: 600;
  background-color: transparent;
}
.dimension-row {
  width: 336px;
  flex-direction: row;
  justify-content: space-between;
}
.dim-card {
  width: 162px;
  border-radius: 18px;
  background-color: #161818;
  border: 1px;
  border-color: rgba(229, 229, 220, 0.12);
  flex-direction: column;
  align-items: center;
  padding: 14px 0 12px;
}
.dim-value {
  color: #e5e5dc;
  font-size: 32px;
  line-height: 40px;
  font-weight: 700;
  font-family: NumBold;
  margin-top: 2px;
  margin-bottom: 10px;
}
.stepper {
  flex-direction: row;
  align-items: center;
}
.step-btn {
  width: 44px;
