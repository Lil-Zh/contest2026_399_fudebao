<template>
  <div class="screen screen-round">
    <div class="fit fit-round">
      <div class="status-space"></div>
      <text class="page-title">选择球场</text>
      <list class="list" scrollpage="true">
        <list-item class="section" type="recent-header" if="{{recent}}">
          <text class="section-title">最近使用</text>
        </list-item>
        <list-item class="item-wrap" if="{{recent}}" type="recent">
          <div class="pitch-card {{recent.selected ? 'pitch-card-on' : ''}}" onclick="onSelectRecent">
            <div class="card-main">
              <text class="pitch-name">{{recent.name}}</text>
              <text class="pitch-size">{{recent.size}}</text>
            </div>
            <div if="{{recent.selected}}" class="check-dot"></div>
          </div>
        </list-item>

        <list-item class="section" type="preset-header">
          <text class="section-title">内置球场</text>
        </list-item>
        <list-item class="item-wrap" for="{{presets}}" tid="id" type="preset">
          <div class="pitch-card {{$item.selected ? 'pitch-card-on' : ''}}" onclick="onSelectPreset($item.type)">
            <div class="card-main">
              <text class="pitch-name">{{$item.name}}</text>
              <text class="pitch-size">{{$item.size}}</text>
            </div>
            <div if="{{$item.selected}}" class="check-dot"></div>
          </div>
        </list-item>

        <list-item class="section" type="custom-header" if="{{customPitches.length > 0}}">
          <text class="section-title">我的球场</text>
        </list-item>
        <list-item class="item-wrap" for="{{customPitches}}" tid="id" type="custom" if="{{customPitches.length > 0}}">
          <div class="pitch-card {{$item.selected ? 'pitch-card-on' : ''}}" onclick="onSelectCustom($item.id)">
            <div class="card-main">
              <text class="pitch-name">{{$item.name}}</text>
              <text class="pitch-size">{{$item.size}}</text>
            </div>
            <div if="{{$item.selected}}" class="check-dot"></div>
          </div>
        </list-item>

        <list-item class="item-wrap" type="custom-entry">
          <div class="pitch-card pitch-card-weak" onclick="onCreateCustom">
            <div class="card-main">
              <text class="pitch-name custom-name">自定义球场</text>
              <text class="pitch-size">设置实际尺寸</text>
            </div>
            <image class="entry-arrow" src="/assets/images/chevron_right_weak.png"></image>
          </div>
        </list-item>
      </list>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { attachStorage, hydrateApp, pitchSelectorView, selectPitch, storageAdapter, useApp } from '../../common/app_state.js'
import storage from '@system.storage'

export default {
  private: {
    recent: null,
    presets: [],
    customPitches: []
  },
  onShow() {
    this._app = useApp()
    attachStorage(storageAdapter(storage))
    hydrateApp().then(() => {
      this.refresh()
    }).catch(() => {
      this.refresh()
    })
  },
  refresh() {
    const view = pitchSelectorView()
    this.recent = view.recent
    this.presets = view.presets
    this.customPitches = view.customPitches
  },
  onSelectPreset(type) {
    selectPitch(type).then(() => {
      router.back()
    }).catch(() => {})
  },
  onSelectCustom(id) {
    selectPitch(id).then(() => {
      router.back()
    }).catch(() => {})
  },
  onSelectRecent() {
    if (!this.recent) return
    selectPitch(this.recent.id).then(() => {
      router.back()
    }).catch(() => {})
  },
  onCreateCustom() {
    router.push({ uri: 'pages/CustomPitch' })
  }
}
</script>

