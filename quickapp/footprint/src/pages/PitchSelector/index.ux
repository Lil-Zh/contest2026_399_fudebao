  width: 376px;
  height: 100%;
  flex-direction: column;
}
.screen-round {
  padding: 0;
}
.fit-round {
  width: 336px;
  height: 100%;
  flex-direction: column;
  align-items: center;
}
.status-space {
  height: 52px;
}
.page-title {
  color: #e5e5dc;
  font-size: 26px;
  line-height: 32px;
  font-weight: 600;
  margin-top: 6px;
  margin-bottom: 12px;
  text-align: center;
}
.list {
  flex: 1;
  flex-direction: column;
  width: 336px;
}
.section {
  width: 336px;
  height: 28px;
  justify-content: flex-end;
}
.section-title {
  color: #9d9d95;
  font-size: 13px;
  line-height: 18px;
}
.item-wrap {
  width: 336px;
  height: 82px;
  margin-bottom: 8px;
}
.pitch-card {
  width: 336px;
  height: 74px;
  border-radius: 18px;
  background-color: #161818;
  border: 1px;
  border-color: rgba(229, 229, 220, 0.12);
  flex-direction: row;
  align-items: center;
  padding: 0 16px;
}
.pitch-card-on {
  border-color: #e7ff00;
}
.pitch-card-weak {
  background-color: rgba(22, 24, 24, 0.72);
}
.card-main {
  flex: 1;
  flex-direction: column;
}
.pitch-name {
  color: #e5e5dc;
  font-size: 19px;
  line-height: 26px;
  font-weight: 600;
}
.custom-name {
  color: #9d9d95;
}
.pitch-size {
  color: #9d9d95;
  font-size: 15px;
  line-height: 21px;
  margin-top: 2px;
}
.check-dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  background-color: #e7ff00;
  margin-left: 10px;
}
.entry-arrow {
  width: 16px;
  height: 16px;
  margin-left: 10px;
}
</style>
