<template>
  <div class="screen">
      <div class="pm-page">
        <div class="status-space"></div>
        <div class="pm-header">
          <image class="pm-check" src="/assets/images/prematch_check.png"></image>
          <text class="pm-header-text">赛前检查 · 准备就绪</text>
        </div>
        <text class="pm-title">{{fieldName}}</text>
        <text class="pm-sub">{{fieldSub}}</text>

        <div class="pm-stats">
          <div class="pm-stat pm-stat-phone">
            <image class="pm-stat-icon" src="/assets/images/st_phone.png"></image>
            <text class="pm-stat-label">手机</text>
            <div class="pm-stat-value">
              <div class="pm-dot {{phoneTone}}"></div>
              <text class="pm-stat-text">{{phoneValue}}</text>
            </div>
          </div>
          <div class="pm-stat pm-stat-gnss">
            <image class="pm-stat-icon" src="/assets/images/st_gnss.png"></image>
            <text class="pm-stat-label">GNSS</text>
            <div class="pm-stat-value">
              <div class="pm-dot {{gnssTone}}"></div>
              <text class="pm-stat-text">{{gnssValue}}</text>
            </div>
          </div>
          <div class="pm-stat pm-stat-hr">
            <image class="pm-stat-icon" src="/assets/images/st_heart.png"></image>
            <text class="pm-stat-label">心率</text>
            <div class="pm-stat-value">
              <div class="pm-dot {{hrTone}}"></div>
              <text class="pm-stat-text">{{hrValue}}</text>
            </div>
          </div>
          <div class="pm-stat pm-stat-battery">
            <image class="pm-stat-icon" src="/assets/images/st_battery.png"></image>
            <text class="pm-stat-label">电量</text>
            <div class="pm-stat-value">
              <div class="pm-dot {{batteryTone}}"></div>
              <text class="pm-stat-text">{{batteryValue}}</text>
            </div>
          </div>
          <div class="pm-stat pm-stat-storage">
            <image class="pm-stat-icon" src="/assets/images/st_storage.png"></image>
            <text class="pm-stat-label">存储</text>
            <div class="pm-stat-value">
              <div class="pm-dot {{storageTone}}"></div>
              <text class="pm-stat-text">{{storageValue}}</text>
            </div>
          </div>
        </div>

        <text class="pm-dir-label">进攻方向</text>
        <div class="pm-dir-row">
          <div class="pm-dir-btn pm-dir-left {{direction === 'goalA' ? 'pm-dir-on' : ''}}" onclick="onPickLeft">
            <div class="pm-dir-inner">
              <image class="pm-dir-arrow" src="{{direction === 'goalA' ? '/assets/images/arrow_left_dark.png' : '/assets/images/arrow_left_offwhite.png'}}"></image>
              <text class="pm-dir-text {{direction === 'goalA' ? 'pm-dir-on-text' : ''}}">左球门</text>
            </div>
          </div>
          <div class="pm-dir-btn {{direction === 'goalB' ? 'pm-dir-on' : ''}}" onclick="onPickRight">
            <div class="pm-dir-inner">
              <text class="pm-dir-text {{direction === 'goalB' ? 'pm-dir-on-text' : ''}}">右球门</text>
              <image class="pm-dir-arrow pm-dir-arrow-right" src="{{direction === 'goalB' ? '/assets/images/arrow_right_dark.png' : '/assets/images/arrow_right_offwhite.png'}}"></image>
            </div>
          </div>
        </div>
        <div class="pm-cta" onclick="onStart">
          <text class="pm-cta-text">开始比赛</text>
        </div>
      </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import device from '@system.device'
import { attachStorage, drainQueueOne, hydrateApp, prematchView, startMatch, storageAdapter, tickPrematch, tickWorld, useApp, isCompactScreen } from '../../common/app_state.js'

export default {
  private: {
    compact: false,
    header: '赛前检查',
    offline: false,
    fieldName: '',
    fieldSub: '',
    rows: [],
    phoneValue: '未连接',
    phoneTone: 'warn',
    gnssValue: '搜索中…',
    gnssTone: 'warn',
    hrValue: '准备中…',
    hrTone: 'warn',
    batteryValue: '86%',
    batteryTone: 'ok',
    storageValue: '412 MB 可用',
    storageTone: 'ok',
    direction: 'goalB'
  },
  onShow() {
    this._app = useApp()
    attachStorage(storageAdapter(storage))
    const self = this
    device.getInfo({
      success: function (res) {
        var c = isCompactScreen(res.screenWidth, res.screenHeight)
        setTimeout(function () {
          if (self.compact !== c) self.compact = c
        }, 150)
      },
      fail: function () {}
    })
    hydrateApp().then(() => {
      // The current round-screen Vela renderer corrupts this dense page when
      // sensor-bound nodes are patched every second. Build one deterministic
      // ready snapshot before first paint, then keep the DOM tree stable.
      while (this._app.world.tick < 10) tickWorld(this._app.world, null)
      tickPrematch(this._app.world, this._app.pitch)
      this.refresh()
      // 首次使用还没有球场：弹出紧凑的选球场首页（标题下拉标进列表页），不显示空态
      if (this._empty && !this._selectorPushed) {
        this._selectorPushed = true
        router.push({ uri: 'pages/PitchSelect' })
      }
      this._timer = setInterval(() => {
        tickWorld(this._app.world, null)
        tickPrematch(this._app.world, this._app.pitch)
        drainQueueOne()
      }, 1000)
    })
  },
  onHide() {
    clearInterval(this._timer)
  },
  onDestroy() {
    clearInterval(this._timer)
  },
  refresh() {
    const view = prematchView()
    this._empty = view.empty
    if (this.header !== view.header) this.header = view.header
    if (this.offline !== view.offline) this.offline = view.offline
    if (this.fieldName !== view.fieldName) this.fieldName = view.fieldName
    if (this.fieldSub !== view.fieldSub) this.fieldSub = view.fieldSub
    const phone = view.rows.find(row => row.key === 'phone')
    const gnss = view.rows.find(row => row.key === 'gnss')
    const hr = view.rows.find(row => row.key === 'hr')
    const battery = view.rows.find(row => row.key === 'battery')
    const storageRow = view.rows.find(row => row.key === 'storage')
    if (phone) {
      this.phoneValue = phone.value
      this.phoneTone = phone.tone
    }
    if (gnss) {
      this.gnssValue = gnss.value
      this.gnssTone = gnss.tone
    }
    if (hr) {
      this.hrValue = hr.value
      this.hrTone = hr.tone
    }
    if (battery) {
      this.batteryValue = battery.value
      this.batteryTone = battery.tone
    }
    if (storageRow) {
      this.storageValue = storageRow.value
      this.storageTone = storageRow.tone
    }
  },
  onPickLeft() {
    this.direction = 'goalA'
  },
  onPickRight() {
    this.direction = 'goalB'
  },
  onStart() {
    startMatch(this.direction).then(() => {
      router.push({ uri: 'pages/Record' })
    })
  }
}
</script>

<style>
@font-face {
  font-family: NumBold;
  src: url('/assets/fonts/NumBold.ttf');
}
/* 圆屏原生布局（466×466）：全部元素水平居中，内容总高 440px，
   底部留 16px 弦切安全区，页点 absolute 不占流式布局 */
.screen {
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  align-items: center;
  background-color: #050505;
}
.pm-page {
  flex-direction: column;
  width: 100%;
  flex: 1;
  align-items: center;
}
/* 顶部系统状态栏预留（52→40：圆屏 y=440 处弦宽仅 214px，
   296px 宽的 CTA 底边落在那里会两端出弧线，全链收紧 ~36px） */
.status-space {
  height: 40px;
}
/* 页头：勾选图标 + 状态文案（规格 margin-top 38px 会使总高超屏，实测压缩为 6px） */
.pm-header {
  height: 24px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 4px;
}
.pm-check {
  width: 18px;
  height: 18px;
  margin-right: 6px;
}
.pm-header-text {
  color: #9d9d95;
  font-size: 16px;
  line-height: 24px;
}
/* 标题：球场名 34px 半粗居中 */
.pm-title {
  color: #e5e5dc;
  font-size: 34px;
  line-height: 40px;
  font-weight: 600;
  margin-top: 2px;
  align-self: center;
  text-align: center;
}
/* 副标题：15px 灰色居中 */
.pm-sub {
  color: #9d9d95;
  font-size: 15px;
  line-height: 22px;
  margin-top: 2px;
  align-self: center;
  text-align: center;
}
/* 状态列表：336px 居中，五行各 28px（17px 字号：标签灰、数值主色） */
.pm-stats {
  width: 336px;
  flex-direction: column;
  margin-top: 6px;
}
.pm-stat {
  height: 28px;
  flex-direction: row;
  align-items: center;
}
.pm-stat-icon {
  width: 18px;
  height: 18px;
  margin-right: 8px;
}
.pm-stat-label {
  color: #9d9d95;
  font-size: 17px;
  line-height: 24px;
}
.pm-stat-value {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}
.pm-dot {
  width: 7px;
  height: 7px;
  border-radius: 4px;
  margin-right: 7px;
}
.ok {
  background-color: #e7ff00;
}
.warn {
  background-color: #ffb020;
}
.pm-stat-text {
  color: #e5e5dc;
  font-size: 17px;
  line-height: 24px;
  font-variant-numeric: tabular-nums;
}
/* 进攻方向 */
.pm-dir-label {
  color: #9d9d95;
  font-size: 16px;
  line-height: 24px;
  margin-top: 6px;
  align-self: center;
  text-align: center;
}
.pm-dir-row {
  height: 40px;
  flex-direction: row;
  justify-content: center;
  margin-top: 4px;
}
.pm-dir-btn {
  width: 140px;
  height: 40px;
  border-radius: 999px;
  background-color: #161818;
  border: 1px;
  border-color: rgba(229, 229, 220, 0.16);
  align-items: center;
  justify-content: center;
}
.pm-dir-left {
  margin-right: 10px;
}
.pm-dir-on {
  background-color: #e7ff00;
  border-color: #e7ff00;
}
.pm-dir-inner {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.pm-dir-arrow {
  width: 16px;
  height: 16px;
  margin-right: 6px;
}
.pm-dir-arrow-right {
  margin-right: 0;
  margin-left: 6px;
}
.pm-dir-text {
  color: #e5e5dc;
  font-size: 18px;
  line-height: 26px;
  font-weight: 600;
}
.pm-dir-on-text {
  color: #050505;
  font-weight: 700;
}
/* 主按钮：296×54 全圆角胶囊，本页最宽 */
.pm-cta {
  width: 296px;
  height: 56px;
  border-radius: 999px;
  background-color: #e7ff00;
  align-items: center;
  justify-content: center;
  margin-top: 6px;
  align-self: center;
}
.pm-cta-text {
  color: #050505;
  font-size: 23px;
  line-height: 32px;
  font-weight: 700;
}
</style>
